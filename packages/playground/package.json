    "dockbar": "workspace:^",
    "highlight.js": "^11.11.1",
    "nprogress": "^0.2.0",
    "tweakpane": "^4.0.5",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@highlightjs/vue-plugin": "^2.1.0",
    "@iconify-json/carbon": "^1.2.24",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/logos": "^1.2.11",
