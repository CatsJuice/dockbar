    "@vue/test-utils": "^2.4.11",
    "beasties": "^0.3.5",
    "cypress": "^15.19.0",
    "cypress-vite": "^1.10.2",
    "jsdom": "^29.1.1",
    "pnpm": "^11.17.0",
    "sass": "^1.102.0",
    "taze": "^19.16.0",
