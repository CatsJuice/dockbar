{
  "name": "playground",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "vite-ssg build",
    "dev": "vite --port 3333",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview-https": "serve dist",
    "test": "vitest",
