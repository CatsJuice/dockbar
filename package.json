{
  "name": "dockbar",
  "type": "module",
  "version": "0.1.8",
  "packageManager": "pnpm@11.17.0",
  "description": "A macOS-like dock made with Web-Components",
  "license": "MIT",
  "keywords": [
    "macOS",
    "dock",
    "macOS-dock"
  ],
  "author": "CatsJuice<https://github.com/CatsJuice>",
  "repository": "https://github.com/catsjuice/dockbar/",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dockbar.js"
    },
    "./minimize": {
      "types": "./types/minimize.d.ts",
      "import": "./dockbar.minimize.js"
    },
    "./dist": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dockbar.js"
    }
  },
  "main": "./dockbar.js",
  "module": "./dockbar.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "postinstall": "simple-git-hooks",
    "lint": "eslint .",
    "dev": "cd packages/dockbar && pnpm dev",
    "dev:playground": "pnpm --filter playground dev",
    "build:dockbar": "cd packages/dockbar && pnpm build",
    "build:playground": "pnpm --filter playground build",
    "benchmark:pointer": "node ./scripts/benchmark-pointer.mjs",
    "test:playwright": "playwright test",
    "build": "node ./.build.mjs",
    "publish": "node ./.build.mjs --publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@playwright/test": "^1.62.0",
    "@unocss/eslint-plugin": "^66.7.5",
    "brotli-size": "^4.0.0",
    "bumpp": "^12.0.0",
    "chalk": "^5.6.2",
    "eslint": "^10.8.0",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-react-refresh": "^0.5.3",
    "execa": "^10.0.0",
    "lint-staged": "^17.2.0",
    "pretty-bytes": "^7.1.1",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "simple-git-hooks": "^2.13.1",
    "unocss": "^66.7.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.(ts|js|tsx|jsx|vue)": "eslint --fix"
  }
}
